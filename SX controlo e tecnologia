def mostrar_demonstracao():
    pagamento = tk.Toplevel(janela)
    pagamento.title("Comprovativo de pagamento")
    pagamento.geometry("460x420")
    pagamento.configure(bg=BG)
    pagamento.resizable(False, False)

    pagamento.update_idletasks()

    largura = 460
    altura = 420
    x = (pagamento.winfo_screenwidth() - largura) // 2
    y = (pagamento.winfo_screenheight() - altura) // 2

    pagamento.geometry(
        f"{largura}x{altura}+{x}+{y}"
    )

    tk.Frame(
        pagamento,
        bg=BLUE,
        height=5
    ).pack(fill="x")

    criar_label(
        pagamento,
        "COMPROVATIVO",
        22,
        WHITE,
        True
    ).pack(pady=(12, 2))

    criar_label(
        pagamento,
        "INFORMACAO DE PAGAMENTO",
        11,
        BLUE,
        True
    ).pack(pady=(0, 10))

    detalhes = tk.Frame(
        pagamento,
        bg=CARD,
        highlightbackground=BORDER,
        highlightthickness=1
    )
    detalhes.pack(fill="x", padx=25)

    criar_label(
        detalhes,
        "VALOR",
        10,
        MUTED,
        True
    ).pack(pady=(10, 1))

    criar_label(
        detalhes,
        "50 MT",
        26,
        GREEN,
        True
    ).pack(pady=1)

    criar_label(
        detalhes,
        f"Numero: {CONTACTO}",
        11,
        WHITE
    ).pack(pady=3)

    criar_label(
        detalhes,
        "Estado: Pendente de confirmacao",
        10,
        YELLOW,
        True
    ).pack(pady=(3, 10))

    criar_label(
        pagamento,
        "SX TECH E DESIGN",
        11,
        MUTED,
        True
    ).pack(pady=9)

    def confirmar():
        janela.destroy()

    criar_botao(
        pagamento,
        "OK | FECHAR PROGRAMA",
        BLUE_DARK,
        confirmar
    ).pack(
        side="bottom",
        fill="x",
        padx=45,
        pady=12
    )

    pagamento.transient(janela)
    pagamento.grab_set()
    pagamento.focus_force()


# ==========================================
# AUTENTICACAO
# ==========================================

def clicar_sim():
    senha_janela = tk.Toplevel(janela)
    senha_janela.title("Autenticacao")
    senha_janela.geometry("400x270")
    senha_janela.configure(bg=CARD)
    senha_janela.resizable(False, False)

    senha_janela.update_idletasks()

    x = (
        senha_janela.winfo_screenwidth() - 400
    ) // 2

    y = (
        senha_janela.winfo_screenheight() - 270
    ) // 2

    senha_janela.geometry(f"400x270+{x}+{y}")

    criar_label(
        senha_janela,
        "AUTENTICACAO",
        21,
        WHITE,
        True
    ).pack(pady=(23, 7))

    criar_label(
        senha_janela,
        "Introduza a palavra-passe",
        12,
        MUTED
    ).pack(pady=5)

    entrada = tk.Entry(
        senha_janela,
        show="*",
        font=("Segoe UI", 16),
        justify="center",
        bg=BG,
        fg=WHITE,
        insertbackground=WHITE,
        relief="flat"
    )
    entrada.pack(
        padx=35,
        fill="x",
        ipady=9,
        pady=12
    )
    entrada.focus_set()

    def verificar():
        if entrada.get() == SENHA_CORRETA:
            senha_janela.destroy()

            estado.config(
                text="ACESSO AUTORIZADO",
                fg=GREEN
            )

            mostrar_demonstracao()

        else:
            messagebox.showerror(
                "Erro",
                "Palavra-passe incorrecta.",
                parent=senha_janela
            )

            entrada.delete(0, tk.END)
            entrada.focus_set()

    criar_botao(
        senha_janela,
        "CONFIRMAR",
        BLUE_DARK,
        verificar
    ).pack(fill="x", padx=35, pady=8)

    entrada.bind(
        "<Return>",
        lambda event: verificar()
    )


