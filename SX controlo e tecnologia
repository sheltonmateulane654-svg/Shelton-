def criar_label(
    pai, texto, tamanho=11, cor=WHITE,
    negrito=False, fundo=None, **kwargs
):
    return tk.Label(
        pai,
        text=texto,
        font=(
            "Segoe UI",
            tamanho,
            "bold" if negrito else "normal"
        ),
        fg=cor,
        bg=fundo or pai.cget("bg"),
        **kwargs
    )


def criar_botao(pai, texto, cor, comando):
    return tk.Button(
        pai,
        text=texto,
        font=("Segoe UI", 12, "bold"),
        bg=cor,
        fg=WHITE,
        activebackground=cor,
        activeforeground=WHITE,
        relief="flat",
        bd=0,
        cursor="hand2",
        pady=12,
        padx=12,
        command=comando
    )


